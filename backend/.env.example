# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=resume_analyzer
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Browser clients
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Resume uploads
MAX_RESUME_SIZE_MB=5

# Optional Google Gemini integration
# Leave empty to use the built-in rule-based fallback.
AI_API_KEY=
AI_MODEL=gemini-flash-latest

# Matching weights; these should add up to 1.0.
MATCH_SKILL_WEIGHT=0.60
MATCH_SEMANTIC_WEIGHT=0.40

# Background processing
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Gmail SMTP. Use a Google App Password, never your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
